Screen {
    layout: vertical;
}

#dashboard {
    height: 1fr;
}

#jobs-pane {
    width: 27%;
    min-width: 24;
    border: round $accent;
    padding: 1;
    text-style: none;
}

#details-pane {
    width: 73%;
    border: round $accent;
    padding: 4 3 1 3;
    text-style: none;
}

#jobs-title {
    text-style: bold;
    padding-bottom: 0;
}

#refresh-status {
    color: $text-muted;
    padding-bottom: 1;
}

#job-search {
    height: 3;
    margin: 0;
}

#status-filter {
    height: 3;
    margin: 0 0 1 0;
}

ListView {
    height: 1fr;
}

JobListItem {
    padding: 0 1;
}

JobListItem.-highlight {
    background: $accent;
    color: $text;
}

#details {
    width: 1fr;
    border: none;
    padding: 0;
    text-style: none;
}

#details-screen {
    height: 1fr;
    padding: 2 3;
}

#details-title {
    text-style: bold;
    padding-bottom: 1;
}

#details-output {
    height: 1fr;
    border: round $accent;
    padding: 2;
    background: transparent;
}

#details-actions {
    height: auto;
    padding-top: 1;
}

#details-actions Button {
    margin-right: 1;
}

#history-screen {
    height: 1fr;
    padding: 1 2;
}

#history-title {
    text-style: bold;
    padding-bottom: 1;
}

#history-output {
    height: 1fr;
    border: round $accent;
}

AddJobScreen {
    align: center middle;
}

#add-form {
    width: 84;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#add-form > * {
    width: 1fr;
    margin: 0;
}

#add-title {
    padding: 0 2;
    text-style: bold;
    margin-bottom: 1;
}

AddJobScreen Input, AddJobScreen Select {
    height: 3;
    margin: 0;
}

#add-env {
    height: 4;
    margin: 0;
}

#add-env-help {
    color: $text-muted;
    height: 1;
    margin: 0;
}

#add-throttle {
    margin: 0;
}

.add-switch-row {
    width: 1fr;
    height: 3;
    margin: 0;
    align-vertical: middle;
}

.add-switch-option {
    width: 1fr;
    height: 3;
    margin: 0;
    align-vertical: middle;
}

.add-switch-option Switch {
    width: auto;
    margin-right: 1;
}

.add-switch-option Label {
    width: auto;
    height: 1;
    margin: 0;
}

#purge-logs {
    width: auto;
    margin: 0 1 1 0;
}

#purge-logs-label {
    width: auto;
    margin: 0 0 1 0;
}

#add-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#add-buttons Button {
    margin-left: 1;
}

ConfirmDeleteScreen {
    align: center middle;
}

#confirm-copy {
    width: 56;
    border: round $accent;
    padding: 2 3;
    background: $surface;
}

#confirm-buttons {
    width: 56;
    height: auto;
    padding: 1 3;
    background: $surface;
    align-horizontal: right;
}

#confirm-buttons Button {
    margin-left: 1;
}

LogsScreen {
    layout: vertical;
}

#logs-screen {
    height: 1fr;
    padding: 1 2;
}

#logs-title {
    text-style: bold;
    padding-bottom: 1;
}

#logs-search {
    margin-bottom: 1;
}

#logs-output {
    height: 1fr;
    border: round $accent;
    padding: 1;
}
